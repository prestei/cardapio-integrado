# Docker Compose (database/docker-compose.yml):
# DATABASE_URL="postgresql://cardapio:cardapio@localhost:5432/cardapio?schema=public"
#
# Postgres local (porta 55432, sem senha — scripts do cardapio-adm):
DATABASE_URL="postgresql://cardapio@127.0.0.1:55432/cardapio_on?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# Use 3334 se a porta 3333 já estiver ocupada (ex.: cardapio-adm)
PORT=3334
NODE_ENV=development
FRONTEND_URL="http://localhost:5174"
FRONTEND_URLS="http://localhost:5173,http://localhost:5174,http://localhost:5176,http://localhost:5177,http://localhost:5180"
