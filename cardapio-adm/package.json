{
  "name": "cardapio-adm",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run db:local:start",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local:start": "bash scripts/pg-start.sh",
    "db:local:stop": "bash scripts/pg-stop.sh",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "db:reset": "npm run prisma:reset -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
