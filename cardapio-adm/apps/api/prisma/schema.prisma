generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ATTENDANT
  KITCHEN
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

enum DeliveryZoneType {
  NEIGHBORHOOD
  REGION
  ZIP
  RADIUS
}

enum StatusChangeSource {
  PANEL
  SYSTEM
  CUSTOMER
  API
}

enum QrCodeKind {
  MENU
  TABLE
  COUNTER
  SHOWCASE
  SOCIAL
}

model Establishment {
  id             String   @id @default(cuid())
  name           String
  displayName    String?
  slug           String   @unique
  description    String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  cnpj           String?
  logoUrl        String?
  bannerUrl      String?
  primaryColor   String   @default("#E8A54B")
  secondaryColor String   @default("#1C1C1C")
  accentColor    String   @default("#F2A94A")
  plan           String   @default("Pro")
  isOpen         Boolean  @default(true)
  closedReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            User[]
  menuImports      MenuImport[]
  categories       Category[]
  products         Product[]
  additionalGroups AdditionalGroup[]
  customers        Customer[]
  orders           Order[]
  deliveryZones    DeliveryZone[]
  coupons          Coupon[]
  notifications    Notification[]
  businessHours    BusinessHours[]
  settings         Settings?
  qrCodes          QrCode[]
  orderStatusLogs  OrderStatusHistory[]
  promotions       Promotion[]
  banners          Banner[]
  campaigns        Campaign[]
  cashRegisters    CashRegister[]
  notificationLogs NotificationLog[]
  notificationSettings NotificationSetting?
  customerFavorites CustomerFavorite[]
  paymentEvents    PaymentEvent[]
}

model User {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  email           String
  passwordHash    String
  role            UserRole  @default(ATTENDANT)
  phone           String?
  avatarUrl       String?
  isActive        Boolean   @default(true)
  resetToken      String?
  resetTokenExp   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  establishment      Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  statusChanges      OrderStatusHistory[]
  assignedDeliveries Order[]              @relation("AssignedDelivery")
  cashRegistersOpened CashRegister[]      @relation("CashOpenedBy")
  cashRegistersClosed CashRegister[]      @relation("CashClosedBy")
  cashMovements      CashMovement[]
  menuImports        MenuImport[]

  @@unique([establishmentId, email])
  @@index([establishmentId])
}

model Category {
  id              String   @id @default(cuid())
  establishmentId String
  name            String
  description     String?
  imageUrl        String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      Product[]
  promotionLinks PromotionCategory[]

  @@index([establishmentId])
}

model Product {
  id              String   @id @default(cuid())
  establishmentId String
  categoryId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  promoPrice      Decimal? @db.Decimal(10, 2)
  imageUrl        String?
  internalCode    String?
  prepTimeMinutes Int?
  stock           Int?
  isAvailable     Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment    Establishment            @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category         Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  additionalGroups ProductAdditionalGroup[]
  orderItems       OrderItem[]
  promotionLinks   PromotionProduct[]
  favorites        CustomerFavorite[]

  @@index([establishmentId])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model AdditionalGroup {
  id              String        @id @default(cuid())
  establishmentId String
  name            String
  description     String?
  selectionType   SelectionType @default(SINGLE)
  isRequired      Boolean       @default(false)
  minQuantity     Int           @default(0)
  maxQuantity     Int           @default(1)
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  establishment Establishment            @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  additionals   Additional[]
  products      ProductAdditionalGroup[]

  @@index([establishmentId])
}

model ProductAdditionalGroup {
  id                String @id @default(cuid())
  productId         String
  additionalGroupId String
  sortOrder         Int    @default(0)

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  additionalGroup AdditionalGroup @relation(fields: [additionalGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, additionalGroupId])
  @@index([additionalGroupId])
}

model Additional {
  id                String   @id @default(cuid())
  additionalGroupId String
  name              String
  description       String?
  price             Decimal  @db.Decimal(10, 2) @default(0)
  imageUrl          String?
  isAvailable       Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  additionalGroup      AdditionalGroup       @relation(fields: [additionalGroupId], references: [id], onDelete: Cascade)
  orderItemAdditionals OrderItemAdditional[]

  @@index([additionalGroupId])
}

model Customer {
  id              String   @id @default(cuid())
  establishmentId String
  name            String
  phone           String
  email           String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  addresses     Address[]
  orders        Order[]
  favorites     CustomerFavorite[]

  @@unique([establishmentId, phone])
  @@index([establishmentId])
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  street       String
  number       String?
  complement   String?
  neighborhood String
  city         String
  state        String?
  zipCode      String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
}

model Order {
  id                     String      @id @default(cuid())
  establishmentId        String
  customerId             String?
  addressId              String?
  code                   String
  type                   OrderType
  status                 OrderStatus @default(NEW)
  subtotal               Decimal     @db.Decimal(10, 2)
  deliveryFee            Decimal     @db.Decimal(10, 2) @default(0)
  discount               Decimal     @db.Decimal(10, 2) @default(0)
  total                  Decimal     @db.Decimal(10, 2)
  notes                  String?
  couponId               String?
  statusHistory          Json?
  isScheduled            Boolean     @default(false)
  scheduledFor           DateTime?
  assignedDeliveryUserId String?
  deliveryLeftAt         DateTime?
  deliveryCompletedAt    DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  establishment    Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer         Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address          Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon           Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payment          Payment?
  couponUsages     CouponUsage[]
  statusLogs       OrderStatusHistory[]
  assignedDelivery User?                @relation("AssignedDelivery", fields: [assignedDeliveryUserId], references: [id], onDelete: SetNull)

  @@unique([establishmentId, code])
  @@index([establishmentId, status])
  @@index([establishmentId, createdAt])
  @@index([assignedDeliveryUserId])
}

model OrderStatusHistory {
  id              String             @id @default(cuid())
  establishmentId String
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  userId          String?
  source          StatusChangeSource @default(SYSTEM)
  note            String?
  createdAt       DateTime           @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([establishmentId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  notes     String?

  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  additionals OrderItemAdditional[]

  @@index([orderId])
}

model OrderItemAdditional {
  id           String  @id @default(cuid())
  orderItemId  String
  additionalId String?
  name         String
  price        Decimal @db.Decimal(10, 2)

  orderItem  OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  additional Additional? @relation(fields: [additionalId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  paidAt          DateTime?
  provider        String?
  externalId      String?
  qrCodeBase64    String?
  copyPaste       String?
  checkoutUrl     String?
  expiresAt       DateTime?
  installments    Int?
  failureReason   String?
  idempotencyKey  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@index([externalId])
  @@index([idempotencyKey])
}

model DeliveryZone {
  id               String           @id @default(cuid())
  establishmentId  String
  name             String
  zoneType         DeliveryZoneType @default(NEIGHBORHOOD)
  fee              Decimal          @db.Decimal(10, 2)
  minOrderValue    Decimal?         @db.Decimal(10, 2)
  estimatedMinutes Int?
  zipPrefix        String?
  radiusKm         Decimal?         @db.Decimal(5, 2)
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
}

model Coupon {
  id               String     @id @default(cuid())
  establishmentId  String
  code             String
  description      String?
  type             CouponType
  value            Decimal    @db.Decimal(10, 2)
  minOrderValue    Decimal?   @db.Decimal(10, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  usageCount       Int        @default(0)
  isActive         Boolean    @default(true)
  isArchived       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]
  usages        CouponUsage[]

  @@unique([establishmentId, code])
  @@index([establishmentId])
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
}

model Notification {
  id              String   @id @default(cuid())
  establishmentId String
  title           String
  message         String
  type            String   @default("info")
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, isRead])
}

model BusinessHours {
  id              String   @id @default(cuid())
  establishmentId String
  dayOfWeek       Int
  openTime        String?
  closeTime       String?
  breakStart      String?
  breakEnd        String?
  isClosed        Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, dayOfWeek])
}

model Settings {
  id                    String   @id @default(cuid())
  establishmentId       String   @unique
  deliveryFeeType       String   @default("FIXED")
  fixedDeliveryFee      Decimal? @db.Decimal(10, 2)
  minOrderValue         Decimal? @db.Decimal(10, 2)
  minOrderDelivery      Decimal? @db.Decimal(10, 2)
  minOrderMessage       String?
  freeDeliveryAbove     Decimal? @db.Decimal(10, 2)
  deliveryRadiusKm      Decimal? @db.Decimal(5, 2)
  estimatedMinutes      Int?
  acceptCash            Boolean  @default(true)
  acceptPix             Boolean  @default(true)
  acceptCard            Boolean  @default(true)
  acceptOnline          Boolean  @default(false)
  acceptDelivery        Boolean  @default(true)
  acceptPickup          Boolean  @default(true)
  acceptDineIn          Boolean  @default(true)
  allowScheduledOrders  Boolean  @default(false)
  scheduleMinLeadMinutes Int     @default(60)
  scheduleMaxDaysAhead   Int     @default(7)
  scheduleSlotMinutes    Int     @default(30)
  scheduleMaxPerSlot     Int?
  notifyWhatsApp         Boolean  @default(false)
  notifyEmail            Boolean  @default(false)
  notifyPush             Boolean  @default(false)
  publicMenuSlug        String?
  themeMode             String   @default("dark")
  menuSectionsJson      Json?
  cancellationPolicy    String?
  deliveryPolicy        String?
  privacyPolicy         String?
  termsOfUse            String?
  extraInfo             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model QrCode {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  kind            QrCodeKind @default(MENU)
  targetPath      String    @default("")
  tableLabel      String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
}

enum PromotionType {
  PERCENTAGE
  FIXED
  PROMO_PRICE
  BUY_X_GET_Y
  COMBO
  FREE_DELIVERY
  CATEGORY
  PRODUCT
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum CashMovementType {
  SALE
  INCOME
  OUTCOME
  BLEED
  ADJUSTMENT
  REFUND
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  PUSH
  IN_APP
}

enum NotificationLogStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Promotion {
  id              String          @id @default(cuid())
  establishmentId String
  name            String
  description     String?
  type            PromotionType
  value           Decimal         @db.Decimal(10, 2) @default(0)
  buyQuantity     Int?
  getQuantity     Int?
  imageUrl        String?
  startsAt        DateTime?
  endsAt          DateTime?
  startTime       String?
  endTime         String?
  usageLimit      Int?
  usageCount      Int             @default(0)
  priority        Int             @default(0)
  sortOrder       Int             @default(0)
  status          PromotionStatus @default(DRAFT)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  establishment Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      PromotionProduct[]
  categories    PromotionCategory[]
  campaigns     CampaignPromotion[]

  @@index([establishmentId, status])
  @@index([establishmentId, isActive])
}

model PromotionProduct {
  id           String @id @default(cuid())
  promotionId  String
  productId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
}

model PromotionCategory {
  id           String @id @default(cuid())
  promotionId  String
  categoryId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
}

model Banner {
  id              String    @id @default(cuid())
  establishmentId String
  title           String
  subtitle        String?
  imageUrl        String
  buttonLabel     String?
  linkUrl         String?
  productId       String?
  categoryId      String?
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int       @default(0)
  showDesktop     Boolean   @default(true)
  showMobile      Boolean   @default(true)
  isActive        Boolean   @default(true)
  views           Int       @default(0)
  clicks          Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  establishment Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  campaigns     CampaignBanner[]

  @@index([establishmentId, isActive])
}

model Campaign {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  objective       String?
  startsAt        DateTime?
  endsAt          DateTime?
  segment         String?
  status          String    @default("DRAFT")
  views           Int       @default(0)
  clicks          Int       @default(0)
  ordersCount     Int       @default(0)
  revenue         Decimal   @db.Decimal(12, 2) @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  establishment Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  banners       CampaignBanner[]
  promotions    CampaignPromotion[]

  @@index([establishmentId])
}

model CampaignBanner {
  id         String @id @default(cuid())
  campaignId String
  bannerId   String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  banner   Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, bannerId])
}

model CampaignPromotion {
  id           String @id @default(cuid())
  campaignId   String
  promotionId  String

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([campaignId, promotionId])
}

model CashRegister {
  id              String             @id @default(cuid())
  establishmentId String
  openedById      String
  closedById      String?
  status          CashRegisterStatus @default(OPEN)
  openingAmount   Decimal            @db.Decimal(12, 2)
  closingAmount   Decimal?           @db.Decimal(12, 2)
  expectedAmount  Decimal?           @db.Decimal(12, 2)
  difference      Decimal?           @db.Decimal(12, 2)
  openingNote     String?
  closingNote     String?
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  openedBy      User           @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy      User?          @relation("CashClosedBy", fields: [closedById], references: [id])
  movements     CashMovement[]

  @@index([establishmentId, status])
}

model CashMovement {
  id              String           @id @default(cuid())
  cashRegisterId  String
  establishmentId String
  userId          String
  type            CashMovementType
  amount          Decimal          @db.Decimal(12, 2)
  reason          String?
  orderId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([cashRegisterId])
  @@index([establishmentId])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  establishmentId String
  paymentId       String
  provider        String
  eventType       String
  externalId      String?
  payload         Json?
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([establishmentId, createdAt])
}

model NotificationLog {
  id              String                @id @default(cuid())
  establishmentId String
  channel         NotificationChannel
  eventKey        String
  recipient       String
  payload         Json?
  status          NotificationLogStatus @default(PENDING)
  error           String?
  idempotencyKey  String                @unique
  attempts        Int                   @default(0)
  sentAt          DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, eventKey])
}

model NotificationSetting {
  id              String  @id @default(cuid())
  establishmentId String  @unique
  whatsappEnabled Boolean @default(false)
  emailEnabled    Boolean @default(false)
  pushEnabled     Boolean @default(false)
  eventsJson      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model CustomerFavorite {
  id              String   @id @default(cuid())
  establishmentId String
  customerId      String?
  phone           String
  productId       String
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, phone, productId])
  @@index([establishmentId, phone])
}

enum MenuImportStatus {
  PROCESSING
  AWAITING_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

model MenuImport {
  id               String           @id @default(cuid())
  establishmentId  String
  userId           String
  status           MenuImportStatus @default(PROCESSING)
  displayFileName  String?
  errorMessage     String?
  errorDetails     String?          @db.Text
  ocrText          String?          @db.Text
  extractedData    Json?
  processingSteps  Json?
  statsCategories  Int              @default(0)
  statsProducts    Int              @default(0)
  statsAdditionals Int              @default(0)
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  files         MenuImportFile[]

  @@index([establishmentId, createdAt])
  @@index([establishmentId, status])
}

model MenuImportFile {
  id              String   @id @default(cuid())
  importId        String
  establishmentId String
  originalName    String
  mimeType        String
  size            Int
  storagePath     String
  pageIndex       Int      @default(0)
  previewPath     String?
  width           Int?
  height          Int?
  createdAt       DateTime @default(now())

  import MenuImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([establishmentId])
}
