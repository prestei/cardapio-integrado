# Docker Compose (padrão do plano):
# DATABASE_URL="postgresql://cardapio:cardapio@localhost:5432/cardapio?schema=public"
#
# Postgres local embutido (scripts/pg-start.sh na porta 55432):
DATABASE_URL="postgresql://cardapio@127.0.0.1:55432/cardapio?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3333
NODE_ENV=development
FRONTEND_URL="http://localhost:5177"
FRONTEND_URLS="http://localhost:5174,http://localhost:5177"

# Pagamentos
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=mercadopago
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_MAX_INSTALLMENTS=12

# Mapas / geolocalização (opcional — checkout nunca falha sem isso)
GOOGLE_MAPS_API_KEY=

# Notificações
NOTIFICATIONS_ENABLED=true
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
